{
  "name": "await-at-least",
  "version": "0.0.0",
  "description": "A small set of functions to await at least a certain amount of time before resolving a promise.",
  "license": "ISC",
  "packageManager": "bun@1.4.4",
  "prettier": "@tobysmith568/prettier-config",
  "type": "module",
  "keywords": [
    "await",
    "at",
    "least",
    "time",
    "delay",
    "promise",
    "wait",
    "timeout"
  ],
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "homepage": "https://github.com/tobysmith568/await-at-least",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/await-at-least.git"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/await-at-least/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "devDependencies": {
    "@license-cop/permissive": "^2.2.1",
    "@tobysmith568/eslint-config": "^3.2.0",
    "@tobysmith568/prettier-config": "^2.2.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "license-cop": "^2.2.1",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.0"
  }
}
